<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ScootRadar covers %lld cities in %lld countries.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>ScootRadar couvre %#@cities@ dans %#@countries@.</string>
		<key>cities</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld&#x00A0;ville</string>
			<key>other</key>
			<string>%lld&#x00A0;villes</string>
		</dict>
		<key>countries</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld&#x00A0;pays</string>
			<key>other</key>
			<string>%lld&#x00A0;pays</string>
		</dict>
	</dict>
</dict>
</plist>
