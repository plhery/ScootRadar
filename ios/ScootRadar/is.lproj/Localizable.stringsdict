<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ScootRadar covers %lld cities in %lld countries.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>ScootRadar nær yfir %#@cities@ í %#@countries@.</string>
		<key>cities</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld&#x00A0;stað</string>
			<key>other</key>
			<string>%lld&#x00A0;staði</string>
		</dict>
		<key>countries</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld&#x00A0;landi</string>
			<key>other</key>
			<string>%lld&#x00A0;löndum</string>
		</dict>
	</dict>
	<key>%lld faded, last seen at %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@faded@ %@.</string>
		<key>faded</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld dauf, sást síðast kl.</string>
			<key>other</key>
			<string>%lld daufar, sáust síðast kl.</string>
		</dict>
	</dict>
	<key>%lld faded, last seen at %@, updating.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@faded@ %@, uppfærist.</string>
		<key>faded</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld dauf, sást síðast kl.</string>
			<key>other</key>
			<string>%lld daufar, sáust síðast kl.</string>
		</dict>
	</dict>
</dict>
</plist>
