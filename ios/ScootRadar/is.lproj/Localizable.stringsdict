<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ScootRadar covers %lld cities in %lld countries.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>ScootRadar nær yfir %#@cities@ í %#@countries@.</string>
		<key>cities</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld stað</string>
			<key>other</key>
			<string>%lld staði</string>
		</dict>
		<key>countries</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld landi</string>
			<key>other</key>
			<string>%lld löndum</string>
		</dict>
	</dict>
</dict>
</plist>
