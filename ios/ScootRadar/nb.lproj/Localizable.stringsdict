<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ScootRadar covers %lld cities in %lld countries.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>ScootRadar dekker %#@cities@ i %#@countries@.</string>
		<key>cities</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld&#x00A0;by</string>
			<key>other</key>
			<string>%lld&#x00A0;byer</string>
		</dict>
		<key>countries</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld&#x00A0;land</string>
			<key>other</key>
			<string>%lld&#x00A0;land</string>
		</dict>
	</dict>
	<key>%lld faded, last seen at %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@faded@ %@.</string>
		<key>faded</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld blek, sist sett kl.</string>
			<key>other</key>
			<string>%lld bleke, sist sett kl.</string>
		</dict>
	</dict>
	<key>%lld faded, last seen at %@, updating.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@faded@ %@, oppdateres.</string>
		<key>faded</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld blek, sist sett kl.</string>
			<key>other</key>
			<string>%lld bleke, sist sett kl.</string>
		</dict>
	</dict>
</dict>
</plist>
