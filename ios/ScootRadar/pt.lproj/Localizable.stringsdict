<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ScootRadar covers %lld cities in %lld countries.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>O ScootRadar abrange %#@cities@ em %#@countries@.</string>
		<key>cities</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld&#x00A0;cidade</string>
			<key>other</key>
			<string>%lld&#x00A0;cidades</string>
		</dict>
		<key>countries</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld&#x00A0;país</string>
			<key>other</key>
			<string>%lld&#x00A0;países</string>
		</dict>
	</dict>
	<key>%lld faded, last seen at %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@faded@ %@.</string>
		<key>faded</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld esbatida, vista pela última vez às</string>
			<key>other</key>
			<string>%lld esbatidas, vistas pela última vez às</string>
		</dict>
	</dict>
	<key>%lld faded, last seen at %@, updating.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@faded@ %@, a atualizar.</string>
		<key>faded</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld esbatida, vista pela última vez às</string>
			<key>other</key>
			<string>%lld esbatidas, vistas pela última vez às</string>
		</dict>
	</dict>
</dict>
</plist>
