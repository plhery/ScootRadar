/* Filters › Range and Settings › Units (issues #12 and #14) */
/* Filters: the heading of the minimum range, a slider that is the filters' only minimum. Range is how far a scooter can go on its charge, as on its card ("Estimated range"). */
"Range" = "Autonomia";
/* Filters: under the range slider while a minimum is set, last. A scooter that gives neither its range nor its battery can't be judged. */
"Scooters without range or battery info are hidden while a minimum is set." = "I monopattini senza dati sull’autonomia né sulla batteria sono nascosti finché è impostato un minimo.";
/* Filters: under the range slider while a minimum is set, where apps in view give a battery and no range: the battery each needs, judged pessimistically from its app's full battery. %@ is a list of "%1$lld%% (%2$@)": "52% (Lime) and 21% (Bolt and Voi)". */
"Scooters that only report a battery need at least %@." = "I monopattini che indicano solo la batteria devono averne almeno %@.";
/* Filters: one item of the list above: a battery minimum and the apps it is for, "21% (Bolt and Voi)". %1$lld is the percent, %2$@ a list of app names. */
"%1$lld%% (%2$@)" = "%1$lld%% (%2$@)";
/* Filters: under the range slider, where an app's battery-only scooters are all hidden, as even a full battery may not take them as far as the minimum. %1$@ is a list of app names, "Lime" or "Lime and Jet"; %2$@ the minimum with its unit, "12 km". */
"Scooters from %1$@ that only report a battery are hidden, as a full battery may not reach %2$@." = "I monopattini %1$@ che indicano solo la batteria sono nascosti: una batteria carica potrebbe non bastare per %2$@.";
/* The "hidden by your filters" card, after the providers: "Lime only · range 5 km or more". %@ is a distance with its unit, "5 km" or "3 mi". Starts in lower case, as "battery %lld%% or more". */
"range %@ or more" = "autonomia di %@ o più";
/* Filters: what VoiceOver and TalkBack read as the range slider's value, %@ a distance with its unit: "5 km or more". */
"%@ or more" = "%@ o più";
/* Settings: the heading of the choice of distance units: Auto, km or mi. "km" and "mi" are written as they are in every language. */
"Units" = "Unità";
/* Settings › Units: what VoiceOver and TalkBack read for the "km" segment. */
"Kilometres" = "Chilometri";
/* Settings › Units: what VoiceOver and TalkBack read for the "mi" segment. */
"Miles" = "Miglia";
