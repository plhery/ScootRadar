{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "swiss-scooters",
  "main": "worker.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "scootradar.com",
      "custom_domain": true
    },
    // Lead to scootradar.com: worker.ts and src/lib/legacyHost.ts.
    {
      "pattern": "www.scootradar.com",
      "custom_domain": true
    },
    {
      "pattern": "scooters.plhery.com",
      "custom_domain": true
    },
    {
      "pattern": "swiss-scooters.plhery.com",
      "custom_domain": true
    },
    {
      "pattern": "zurich-scooter.plhery.com",
      "custom_domain": true
    }
  ],
  "vars": {
    // scootradar.com's settings, which the build reads too (next.config.ts). What each does, and its
    // default where it is left out: src/lib/siteSettings.ts and README.md, "Run your own". The name,
    // the guides and the apps are ScootRadar's own and not for a copy: TRADEMARKS.md.
    "SITE_URL": "https://scootradar.com",
    "SITE_NAME": "ScootRadar",
    "SITE_GUIDES": "on",
    "SITE_MAKER": "on",
    "CONTACT_EMAIL": "hello@scootradar.com",
    "SOURCE_URL": "https://github.com/plhery/ScootRadar",
    "ANALYTICS_URL": "https://u.plhery.com/api/send",
    "ANALYTICS_WEBSITE_ID": "6e60b4ab-b4ee-4785-9699-a7f32127b358",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGHng4PaY6p_ONop",
    "APP_STORE_ID": "6823614854",
    "APP_STORE_PROVIDER_TOKEN": "129628155",
    "ANDROID_APP_ID": "com.plhery.scootradar",
    "PLAY_TEST_GROUP": "https://groups.google.com/g/scootradar-android-testers",
    // The scooter cache, without which the Worker collects the feeds itself (DEPLOY.md).
    "SCOOTER_SNAPSHOT_API_URL": "https://scooter-data.plhery.com",
    // Valhalla for walking routes: src/app/api/walk/route.ts. FOSSGIS asks
    // that its address be set here rather than in the app.
    "WALK_ROUTE_API_URL": "https://valhalla1.openstreetmap.de/route"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "ratelimits": [
    {
      "name": "SCOOTER_API_RATE_LIMITER",
      "namespace_id": "1824001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "GEOCODE_API_RATE_LIMITER",
      "namespace_id": "1824002",
      // The apps search at every pause in typing: one address is several requests.
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "WALK_API_RATE_LIMITER",
      "namespace_id": "1824003",
      // A walk asks once, then again only when the walker leaves the way.
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "WALK_UPSTREAM_RATE_LIMITER",
      "namespace_id": "1824004",
      // All visitors together, by one key: FOSSGIS allows one request a second.
      // Counted over ten seconds, the shortest period, to keep bursts small.
      // Cloudflare counts per location, so this is a ceiling for each, not for all.
      "simple": {
        "limit": 10,
        "period": 10
      }
    }
  ],
  // Announced maintenance, shared with the other sites' edge guards: src/lib/maintenance.ts, DEPLOY.md
  // ("Maintenance").
  "kv_namespaces": [{ "binding": "MAINTENANCE", "id": "8b0f39fd21c2415e83cffc05a0307b37" }],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
