# Optional public contact identifier sent to sharedmobility.ch.
# This is not a secret.
SHAREDMOBILITY_AUTH_EMAIL=hello@scootradar.com

# Shared Worker-to-origin credential, required for production cache/proxy use.
# Configure the SAME random value (32+ characters) as an encrypted Worker secret
# and a Coolify cache environment secret. Leave unset for local Next.js dev.
# SCOOTER_SNAPSHOT_API_TOKEN=

# LUUP rider session: private Node cache runtime secrets in Coolify, never NEXT_PUBLIC_ or build variables.
# LUUP_REFRESH_TOKEN=
# LUUP_FIREBASE_API_KEY=
# Renewed refresh tokens are saved privately beside the scooter snapshot, overridable with LUUP_SESSION_PATH.

# JET's signed-out Go Jet map: private app signing configuration on the Node cache volume.
# JET_CONFIG_PATH=/data/jet-config.json
# Whoosh: the Node cache reads a private mode-0600 whoosh-session.json beside the snapshot.
# WHOOSH_SESSION_PATH=/private/path/to/whoosh-session.json
