<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Whether a request that failed was offline (ScooterAPI's isOffline). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The rider's place while the app is in use, asked only when the rider asks to be located (LOG-241, LOG-242):
         both, so that Android 12 offers precise and approximate. Nothing in the background. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Android 12 has no App languages setting to read localeConfig: AppCompat keeps the app's language there.
         Backups take the settings and that language only (LOG-298). -->
    <application
        android:name=".app.ScooterApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScootRadar"
        tools:targetApi="tiramisu">
        <!-- iOS never recreates the screen: rotation, a resized window, dark mode and a language chosen for the
             app reach the screen as they are (X-AD17, PLAN §10). -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- scootradar.com's links to the map open in the app, as the iPhone's universal links do (UI-377, X-AD08):
                 /map, and "/", where the map was before the landing page. MainActivity hands a "/" without an origin
                 on to the browser, as the iPhone's apple-app-site-association leaves it on the web. Verified once the
                 site has the app's assetlinks.json (NEEDS-USER #9). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="scootradar.com" />
                <data android:host="www.scootradar.com" />
                <data android:path="/map" />
                <data android:path="/map/" />
                <data android:path="/" />
            </intent-filter>
        </activity>

        <!-- AppCompat keeps a language chosen for the app itself on Android 12, which has no LocaleManager (X-AD14). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
