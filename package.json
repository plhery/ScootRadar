{
  "name": "scootradar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:providers": "node scripts/generate-provider-catalog.mjs",
    "check:providers": "node scripts/generate-provider-catalog.mjs --check",
    "check:france": "node scripts/check-french-feeds.mjs",
    "check:europe": "node scripts/check-french-feeds.mjs --countries=europe --except=FR",
    "check:catalogs": "node scripts/check-french-feeds.mjs --countries=all",
    "check:listed-prices": "node scripts/check-listed-prices.mjs",
    "generate:api-contract": "node scripts/generate-api-contract.mjs",
    "check:api-contract": "node scripts/generate-api-contract.mjs --check",
    "check:dependencies": "node scripts/check-dependency-audit.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:landing-images": "node scripts/generate-landing-images.mjs",
    "generate:share-images": "node scripts/generate-share-images.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:contract": "node scripts/check-live-contract.mjs",
    "grafana:sync": "node scripts/sync-grafana.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.8",
    "@tomickigrzegorz/leaflet-rotate": "0.2.4",
    "leaflet": "^1.9.4",
    "next": "^16.3.8",
    "protomaps-leaflet": "5.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@sentry/node": "11.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "postcss": "^8.5.25"
  }
}
